rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Created and ended only via server API routes using the Admin SDK, which
    // bypasses these rules entirely - so no client write path is needed here.
    //
    // `read` is split into get and list on purpose. A single `allow read: if
    // true` also permits listing, which let anyone enumerate every board on
    // the project along with its room code. Fetching one board you already
    // know the id or code of is the access guests actually need.
    match /boards/{boardId} {
      allow get: if true;

      // Firestore evaluates list rules per candidate document and rejects the
      // whole query if any would fail, so this effectively forces the client
      // to filter by their own ownerUid - which is exactly what the "my
      // boards" page does, and all it can do.
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      allow write: if false;

      // Photos and comments both live UNDER their board rather than in
      // top-level collections with a boardId field. That is a rules decision.
      //
      // A top-level collection can only be read with a where("boardId", ...)
      // filter, and Firestore list rules cannot inspect a query's filters - so
      // any rule permitting the gallery's own query also permitted listing
      // every photo on the project. For photos that leaked downloadUrl, which
      // carries its own Storage access token, so it exposed the pictures
      // themselves rather than just metadata.
      //
      // Nesting scopes a list by path: a caller must already know a board id,
      // which is the same thing knowing the room code gets you.
      match /photos/{photoId} {
        allow read: if true;

        // Guests never log in, so there's no auth check - anyone who knows a
        // boardId can add a photo, the same trust model as knowing the room
        // code or QR at all. The shape is validated so a malformed write can't
        // corrupt what every other guest reads.
        //
        // No boardId in this list any more: the path is the only record of
        // which board a photo belongs to, so the two can never disagree.
        allow create: if request.resource.data.keys().hasAll(
                          ['storagePath', 'downloadUrl', 'caption',
                           'contributorName', 'contributorGuestId', 'uploadedAt', 'reactedBy']
                        )
                      && request.resource.data.storagePath is string
                      && request.resource.data.caption is string
                      && request.resource.data.caption.size() <= 280
                      && request.resource.data.contributorName is string
                      && request.resource.data.contributorName.size() <= 40
                      && request.resource.data.reactedBy == {};

        // Guests have no real identity (no Firebase Auth), just a
        // client-generated id in localStorage - so this can't cryptographically
        // guarantee a guest only edits their own entry, only that reactedBy is
        // the sole field anyone is ever allowed to touch after creation. That's
        // the honest boundary available without adding a full auth system.
        //
        // Second clause is a guest deleting their own photo: the claimed
        // deleter must match the recorded contributor, so a client can't
        // casually remove someone else's. Since both are the same spoofable
        // localStorage id that's a speed bump, not a guarantee - it's only safe
        // because deletion is soft. This write hides a photo, never destroys
        // one. The host's moderation goes through an API route with the host
        // key, which the Admin SDK enforces properly.
        //
        // Third clause is undo, permitted only when the photo was removed by
        // its own contributor - so a guest can take back their own mistake but
        // cannot reverse a host's moderation, which sets deletedBy 'host'.
        // Second clause is the uploader editing their own caption. Like the
        // delete clauses it validates shape but cannot verify WHO is editing -
        // there is no guest auth, and contributorGuestId is readable by anyone
        // who can read the photo. One difference is worth naming: a delete can
        // be undone, an edit overwrites the previous text.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactedBy'])
                      || (
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
                           && request.resource.data.caption is string
                           && request.resource.data.caption.size() <= 280
                         )
                      || (
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
                           && request.resource.data.deletedAt is number
                           && request.resource.data.deletedBy == resource.data.contributorGuestId
                         )
                      || (
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
                           && request.resource.data.deletedAt == null
                           && resource.data.deletedBy == resource.data.contributorGuestId
                         );

        // Never a hard delete from a client. Restoring, and any eventual
        // permanent removal, are Admin SDK only - see the admin routes.
        allow delete: if false;
      }

      match /comments/{commentId} {
        allow read: if true;

        // Same trust model as uploading a photo - no auth - but the shape is
        // validated so a malformed write can't corrupt what everyone reads.
        allow create: if request.resource.data.keys().hasAll(
                          ['photoId', 'body', 'authorName', 'authorGuestId',
                           'createdAt', 'deletedAt', 'deletedBy']
                        )
                      && request.resource.data.photoId is string
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 500
                      && request.resource.data.authorName is string
                      && request.resource.data.authorName.size() <= 40
                      && request.resource.data.deletedAt == null
                      && request.resource.data.deletedBy == null;

        // Soft delete and undo, mirroring photos exactly: an author may remove
        // and restore their own, and nothing else about a comment can change
        // once written - so a comment can't be edited into something else
        // after people have read it. A host removal sets deletedBy 'host',
        // which no authorGuestId equals, so a client can't reverse one.
        allow update: if (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
                        && request.resource.data.deletedAt is number
                        && request.resource.data.deletedBy == resource.data.authorGuestId
                      )
                      || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
                        && request.resource.data.deletedAt == null
                        && resource.data.deletedBy == resource.data.authorGuestId
                      );

        allow delete: if false;
      }
    }

    // No client access whatsoever - only the Admin SDK (server API routes)
    // ever touches this collection. See lib/hostAuth.ts.
    match /boardSecrets/{boardId} {
      allow read, write: if false;
    }

    // Account-level host state. Readable by its owner so the UI can show
    // whether Google Photos is connected without a round trip, but written
    // only by the OAuth callback via the Admin SDK.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // The Google refresh token and the shared deleted-photos album live here.
    // Closed to every client, exactly like boardSecrets.
    match /userSecrets/{uid} {
      allow read, write: if false;
    }

    // Pending OAuth handshakes. The nonce IS the secret, so nothing may read
    // or enumerate these - only the callback route resolves them, server-side.
    match /oauthStates/{state} {
      allow read, write: if false;
    }
  }
}
