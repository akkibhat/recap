rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Created and ended only via server API routes using the Admin SDK, which
    // bypasses these rules entirely - so no client write path is needed here.
    //
    // `read` is split into get and list on purpose. A single `allow read: if
    // true` also permits listing, which let anyone enumerate every board on
    // the project along with its room code. Fetching one board you already
    // know the id or code of is the access guests actually need.
    match /boards/{boardId} {
      allow get: if true;

      // Firestore evaluates list rules per candidate document and rejects the
      // whole query if any would fail, so this effectively forces the client
      // to filter by their own ownerUid - which is exactly what the "my
      // boards" page does, and all it can do.
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      allow write: if false;
    }

    // No client access whatsoever - only the Admin SDK (server API routes)
    // ever touches this collection. See lib/hostAuth.ts.
    match /boardSecrets/{boardId} {
      allow read, write: if false;
    }

    // Account-level host state. Readable by its owner so the UI can show
    // whether Google Photos is connected without a round trip, but written
    // only by the OAuth callback via the Admin SDK.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // The Google refresh token and the shared deleted-photos album live here.
    // Closed to every client, exactly like boardSecrets.
    match /userSecrets/{uid} {
      allow read, write: if false;
    }

    // Pending OAuth handshakes. The nonce IS the secret, so nothing may read
    // or enumerate these - only the callback route resolves them, server-side.
    match /oauthStates/{state} {
      allow read, write: if false;
    }

    // Guests never log in, so there's no auth check here - anyone who
    // knows a boardId can add a photo to it, same trust model as knowing
    // the room code/QR at all. Field shape is validated so a malformed
    // write can't corrupt what every other guest reads.
    match /photos/{photoId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(
                        ['boardId', 'storagePath', 'downloadUrl', 'caption',
                         'contributorName', 'contributorGuestId', 'uploadedAt', 'reactedBy']
                      )
                    && request.resource.data.boardId is string
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 280
                    && request.resource.data.contributorName is string
                    && request.resource.data.contributorName.size() <= 40
                    && request.resource.data.reactedBy == {};

      // Guests have no real identity (no Firebase Auth), just a
      // client-generated id in localStorage - so this can't cryptographically
      // guarantee a guest only edits their own entry, only that reactedBy is
      // the sole field anyone is ever allowed to touch after creation. That's
      // the honest boundary available without adding a full auth system.
      //
      // The second clause is a guest deleting their own photo. It requires the
      // claimed deleter to match the recorded contributor, so a client can't
      // casually remove someone else's photo - but since both are the same
      // spoofable localStorage id, that's a speed bump, not a guarantee. It's
      // only safe because deletion here is soft: this write hides a photo, it
      // never destroys one. The host's own moderation goes through an API
      // route with the host key instead, which the Admin SDK enforces properly.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactedBy'])
                    || (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
                         && request.resource.data.deletedAt is number
                         && request.resource.data.deletedBy == resource.data.contributorGuestId
                       );

      // Still never a hard delete from a client. Restoring, and any eventual
      // permanent removal, are Admin SDK only - see the admin routes.
      allow delete: if false;
    }
  }
}
